{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "apps/web/node_modules/.bin/next",
      "runtimeArgs": [
        "dev",
        "apps/web",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "apps/api/node_modules/.bin/next",
      "runtimeArgs": [
        "dev",
        "apps/api",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "apps/web/node_modules/.bin/next",
      "runtimeArgs": [
        "start",
        "apps/web",
        "-p",
        "3002"
      ],
      "port": 3002
    }
  ]
}
